{
  "openapi": "3.0.3",
  "info": {
    "title": "Retro Diffusion API",
    "description": "Pixel art image generation API. Base URL: https://api.retrodiffusion.ai/v1. Auth via X-RD-Token header (keys start with rdpk-). Prefer MCP if available at https://mcp.retrodiffusion.ai/mcp. Style catalog and limits live; use GET /styles/selector for current values. Prompts describe SUBJECT only — never write 'pixel art'. Models ignore 'negative' field.",
    "contact": {
      "url": "https://www.retrodiffusion.ai"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.retrodiffusion.ai/v1",
      "description": "Production"
    }
  ],
  "paths": {
    "/inferences": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        }
      ],
      "post": {
        "summary": "Generate images (sync or async)",
        "description": "Main generation endpoint. Set check_cost=true for free price estimate. Set async=true for long-running jobs (animations/batches). Use upload_outputs=true for signed URLs.",
        "operationId": "CreateInference",
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateInference"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Inference"
          },
          "202": {
            "$ref": "#/components/responses/AsyncAccepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/inferences/tasks/{task_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        },
        {
          "$ref": "#/components/parameters/task_id"
        }
      ],
      "get": {
        "summary": "Poll async inference job",
        "operationId": "GetInferenceJob",
        "responses": {
          "200": {
            "$ref": "#/components/responses/TaskStatus"
          },
          "404": {
            "$ref": "#/components/responses/TaskNotFound"
          }
        }
      }
    },
    "/inferences/requests/{request_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        },
        {
          "$ref": "#/components/parameters/request_id"
        }
      ],
      "get": {
        "summary": "Retrieve generation during 24h retention window",
        "description": "Returns status, settings, billing, and freshly signed output URLs. Any active personal key from owning account may retrieve after key rotation.",
        "operationId": "GetInferenceRequest",
        "responses": {
          "200": {
            "$ref": "#/components/responses/InferenceRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/inferences/credits": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        }
      ],
      "get": {
        "summary": "Get balance and credits",
        "operationId": "GetBalance",
        "responses": {
          "200": {
            "$ref": "#/components/responses/CreditsResponse"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/styles/selector": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        },
        {
          "$ref": "#/components/parameters/model"
        },
        {
          "$ref": "#/components/parameters/tab"
        }
      ],
      "get": {
        "summary": "Live style catalog with limits",
        "operationId": "ListAvailableStyles",
        "responses": {
          "200": {
            "$ref": "#/components/responses/StyleDescriptors"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/styles": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        }
      ],
      "post": {
        "summary": "Create custom user style (RD Pro reference template)",
        "operationId": "CreateUserStyle",
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateUserStyle"
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Style"
          }
        }
      }
    },
    "/styles/{style_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        },
        {
          "$ref": "#/components/parameters/style_id"
        }
      ],
      "delete": {
        "summary": "Delete user style",
        "operationId": "DeleteUserStyle",
        "responses": {
          "200": {
            "$ref": "#/components/responses/DeleteUserStyleOkResponse"
          }
        }
      },
      "patch": {
        "summary": "Update user style",
        "operationId": "UpdateUserStyle",
        "requestBody": {
          "$ref": "#/components/requestBodies/UpdateUserStyle"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/UpdateUserStyleOkResponse"
          }
        }
      }
    },
    "/edit/tools": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        }
      ],
      "get": {
        "summary": "List enabled canvas edit tools",
        "operationId": "ListEditTools",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ListEditToolsOkResponse"
          }
        }
      }
    },
    "/edit/tools/{tool_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        },
        {
          "$ref": "#/components/parameters/tool_id"
        }
      ],
      "post": {
        "summary": "Run edit tool",
        "description": "Tools: image_edit, inpainting, outpainting, seam_tiling, background_remover, color_style_transfer, color_reducer, palette_converter, k_centroid_downscale, pixel_correction, rotate. Free tools may require min balance $0.01.",
        "operationId": "RunEditTool",
        "requestBody": {
          "$ref": "#/components/requestBodies/RunEditTool"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/RunEditToolOkResponse"
          },
          "400": {
            "$ref": "#/components/responses/RunEditToolBadRequestResponse"
          },
          "404": {
            "$ref": "#/components/responses/RunEditToolNotFoundResponse"
          },
          "422": {
            "$ref": "#/components/responses/RunEditToolUnprocessableEntityResponse"
          }
        }
      }
    },
    "/edit/tools/{tool_id}/estimate": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        },
        {
          "$ref": "#/components/parameters/tool_id"
        }
      ],
      "post": {
        "summary": "Estimate edit tool cost (no run)",
        "operationId": "EstimateEditToolCost",
        "requestBody": {
          "$ref": "#/components/requestBodies/EstimateEditToolCost"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/EstimateEditToolCostOkResponse"
          }
        }
      }
    },
    "/pixel-fixer/standard": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        }
      ],
      "post": {
        "summary": "Pixel Fixer Standard (free native-grid reconstruction)",
        "description": "Native Rust grid detection. 16x16 to 16 megapixels. Rate limits: 120/min with purchase history, else 10/min. Shared with neural.",
        "operationId": "FixPixelArtStandard",
        "requestBody": {
          "$ref": "#/components/requestBodies/FixPixelArtStandard"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/FixPixelArtStandardOkResponse"
          },
          "413": {
            "$ref": "#/components/responses/FixPixelArtStandardRequestEntityTooLargeResponse"
          },
          "422": {
            "$ref": "#/components/responses/FixPixelArtStandardUnprocessableEntityResponse"
          },
          "429": {
            "$ref": "#/components/responses/FixPixelArtStandardTooManyRequestsResponse"
          }
        }
      }
    },
    "/pixel-fixer/neural": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        }
      ],
      "post": {
        "summary": "Pixel Fixer Neural (free neural reconstruction)",
        "description": "Accepts larger sources, bilinear-downscales above 1MP budget. Optional width/height target (capped 16MP).",
        "operationId": "FixPixelArtNeural",
        "requestBody": {
          "$ref": "#/components/requestBodies/FixPixelArtNeural"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/FixPixelArtNeuralOkResponse"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "422": {
            "$ref": "#/components/responses/FixPixelArtNeuralUnprocessableEntityResponse"
          },
          "429": {
            "$ref": "#/components/responses/FixPixelArtNeuralTooManyRequestsResponse"
          }
        }
      }
    },
    "/status": {
      "parameters": [
        {
          "$ref": "#/components/parameters/X-Rd-Token"
        }
      ],
      "get": {
        "summary": "Service status (no auth)",
        "operationId": "GetServiceStatus",
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetServiceStatusOkResponse"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "APIError": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "$ref": "#/components/schemas/Errors"
          }
        ],
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/APIErrorDetail"
          }
        }
      },
      "APIErrorDetail": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ErrorWithLocation"
        }
      },
      "AsyncAccepted": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "accepted"
          },
          "task_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "CreateStyleRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "style_icon": {
            "type": "string"
          },
          "reference_images": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reference_caption": {
            "type": "string"
          },
          "apply_prompt_fixer": {
            "type": "boolean",
            "default": true
          },
          "llm_instructions": {
            "type": "string"
          },
          "user_prompt_template": {
            "description": "Must contain the token {prompt}",
            "type": "string"
          },
          "force_palette": {
            "type": "boolean"
          },
          "force_bg_removal": {
            "type": "boolean"
          },
          "min_width": {
            "type": "integer",
            "minimum": 64,
            "maximum": 256
          },
          "min_height": {
            "type": "integer",
            "minimum": 64,
            "maximum": 256
          }
        },
        "required": [
          "name"
        ]
      },
      "CreditsResponse": {
        "type": "object",
        "properties": {
          "credits": {
            "type": "number"
          },
          "balance": {
            "type": "number"
          }
        }
      },
      "DeleteUserStyleOkJSONResponse": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "EditToolEstimate": {
        "type": "object",
        "properties": {
          "tool_id": {
            "type": "string"
          },
          "balance_cost": {
            "type": "number"
          },
          "credit_cost": {
            "type": "number"
          },
          "estimate_seconds": {
            "type": "number"
          }
        }
      },
      "EditToolRequest": {
        "type": "object",
        "properties": {
          "input_image": {
            "description": "Raw base64 or data:image/...;base64 data URI",
            "type": "string"
          },
          "custom_id": {
            "description": "For correlating runs with your queue (not idempotency key)",
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "mask_image": {
            "description": "For inpainting. RGBA PNG preferred: alpha 0 protects, alpha >12 selects. Grayscale also accepted.",
            "type": "string"
          },
          "soft_inpaint": {
            "type": "boolean"
          },
          "expand_left": {
            "type": "integer"
          },
          "expand_right": {
            "type": "integer"
          },
          "expand_top": {
            "type": "integer"
          },
          "expand_bottom": {
            "type": "integer"
          },
          "tile_x": {
            "type": "boolean"
          },
          "tile_y": {
            "type": "boolean"
          },
          "seam_width": {
            "type": "integer"
          },
          "repair_window_size": {
            "type": "integer"
          },
          "transparency_threshold": {
            "type": "number"
          },
          "force_solid_pixels": {
            "type": "boolean"
          },
          "extra_input_image": {
            "type": "string"
          },
          "color_count": {
            "type": "integer"
          },
          "dither_mode": {
            "$ref": "#/components/schemas/EditToolRequestDitherMode"
          },
          "dither_strength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "input_palette": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "rotation_degrees": {
            "type": "integer"
          }
        },
        "required": [
          "input_image"
        ]
      },
      "EditToolRequestDitherMode": {
        "type": "string",
        "enum": [
          "none",
          "bayer_2x2",
          "bayer_4x4",
          "bayer_8x8"
        ]
      },
      "EditToolResponse": {
        "type": "object",
        "properties": {
          "tool_id": {
            "type": "string"
          },
          "inference_id": {
            "type": "string"
          },
          "base64_images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "balance_cost": {
            "type": "number"
          },
          "credit_cost": {
            "type": "number",
            "nullable": true
          },
          "charged": {
            "type": "boolean"
          },
          "remaining_balance": {
            "type": "number"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorWithCode"
          }
        },
        "required": [
          "detail"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string"
          }
        }
      },
      "ErrorDetails": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ErrorDetail"
        }
      },
      "ErrorWithCode": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorWithLocation": {
        "type": "object",
        "properties": {
          "loc": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "body"
            }
          },
          "msg": {
            "type": "string",
            "example": "field required"
          },
          "type": {
            "type": "string",
            "example": "value_error.missing"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ]
      },
      "Errors": {
        "type": "object",
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        }
      },
      "Inference": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "date-time",
            "example": 1788096424
          },
          "balance_cost": {
            "type": "number",
            "format": "double",
            "example": 0.18
          },
          "base64_images": {
            "description": "Raw base64 PNG (or GIF for animations)",
            "type": "array",
            "items": {
              "type": "string",
              "example": null
            }
          },
          "output_urls": {
            "description": "15-minute signed URLs when upload_outputs=true",
            "type": "array",
            "items": {
              "type": "string",
              "example": null
            }
          },
          "model": {
            "type": "string",
            "example": "check_cost"
          },
          "remaining_balance": {
            "type": "number",
            "format": "double",
            "example": 0.5
          },
          "request_id": {
            "type": "string"
          },
          "outputs_retained_until": {
            "type": "integer"
          },
          "credit_cost": {
            "type": "integer",
            "example": 0
          },
          "output_images": {
            "type": "array",
            "items": {
              "type": "object",
              "example": null
            }
          },
          "remaining_credits": {
            "type": "integer",
            "example": 0
          }
        },
        "required": [
          "created_at",
          "balance_cost",
          "base64_images",
          "model",
          "remaining_balance",
          "request_id",
          "outputs_retained_until"
        ]
      },
      "InferenceRequest": {
        "type": "object",
        "properties": {
          "prompt": {
            "description": "Describe the SUBJECT only. Never write 'pixel art'.",
            "type": "string",
            "example": "security officer (a soldier). A 34-year-old male human. Lean and wiry, with a posture that suggests he's always expecting something to break. He wears the standard grey-blue security fatigues, kept meticulously clean despite the dust of the colony. A thin, jagged scar running through his left eyebrow. He has a habit of clicking his tongue when he's impatient."
          },
          "prompt_style": {
            "$ref": "#/components/schemas/PromptStyle"
          },
          "width": {
            "description": "Style-enforced tighter limits apply (most top out at 384)",
            "type": "integer",
            "minimum": 16,
            "maximum": 512,
            "example": 128
          },
          "height": {
            "type": "integer",
            "minimum": 16,
            "maximum": 512,
            "example": 128
          },
          "num_images": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "seed": {
            "description": "Reproducible generation",
            "type": "integer"
          },
          "input_image": {
            "description": "Raw base64 PNG (no data: URI prefix), RGB no transparency. Required for img2img, advanced animation, some edit tools.",
            "type": "string"
          },
          "strength": {
            "description": "How much to change input_image",
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.75
          },
          "reference_images": {
            "description": "Base64 images. RD Pro styles only. Guides style/content.",
            "type": "array",
            "maxItems": 9,
            "items": {
              "type": "string"
            }
          },
          "input_palette": {
            "description": "Base64 palette constraining output colors",
            "type": "string"
          },
          "remove_bg": {
            "description": "Transparent output",
            "type": "boolean"
          },
          "tile_x": {
            "type": "boolean"
          },
          "tile_y": {
            "type": "boolean"
          },
          "frames_duration": {
            "description": "Animation styles only",
            "type": "integer",
            "enum": [
              4,
              6,
              8,
              10,
              12,
              16
            ]
          },
          "return_spritesheet": {
            "description": "Animations: PNG spritesheet instead of GIF",
            "type": "boolean"
          },
          "upscale_output_factor": {
            "description": "1 = native pixel size",
            "type": "integer"
          },
          "bypass_prompt_expansion": {
            "description": "Skip automatic LLM prompt enrichment",
            "type": "boolean"
          },
          "include_downloadable_data": {
            "description": "Extra structured assets e.g. item atlas JSON",
            "type": "boolean"
          },
          "check_cost": {
            "description": "FREE dry run: returns price, generates nothing, charges nothing",
            "type": "boolean"
          },
          "async": {
            "description": "Return task_id for polling instead of waiting",
            "type": "boolean"
          },
          "upload_outputs": {
            "description": "Receive temporary signed URLs in output_urls instead of (or with) base64",
            "type": "boolean"
          },
          "extra_prompt": {
            "description": "For advanced tileset styles",
            "type": "string"
          },
          "extra_input_image": {
            "description": "For advanced tileset styles",
            "type": "string"
          },
          "negative": {
            "description": "Placeholder — current models ignore it. Do not rely on it.",
            "type": "string"
          }
        },
        "required": [
          "prompt",
          "prompt_style",
          "width",
          "height",
          "num_images"
        ]
      },
      "InferenceRequestResult": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      },
      "ListEditToolsOkJSONResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "Model": {
        "type": "string",
        "enum": [
          "rd_fast",
          "rd_plus",
          "rd_pro",
          "rd_mini"
        ],
        "example": "rd_pro"
      },
      "Models": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Model"
        }
      },
      "PixelFixerRequest": {
        "description": "Provide exactly one of input_image or image_url. width/height are optional and only used by the neural endpoint.",
        "type": "object",
        "properties": {
          "input_image": {
            "description": "Raw base64 PNG/JPEG/WebP or data URI",
            "type": "string"
          },
          "image_url": {
            "description": "Public HTTPS PNG/JPEG/WebP",
            "type": "string",
            "format": "uri"
          },
          "width": {
            "description": "Neural only: target output width",
            "type": "integer"
          },
          "height": {
            "description": "Neural only: target output height",
            "type": "integer"
          }
        }
      },
      "PixelFixerResponse": {
        "type": "object",
        "properties": {
          "base64_images": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PromptStyle": {
        "description": "Style id e.g. rd_fast__default, rd_pro__default, rd_plus__default, animation/tile variants, or user__name_id",
        "type": "string",
        "enum": [
          "rd_animation__8_dir_rotation",
          "rd_animation__any_animation",
          "rd_animation__big_animation",
